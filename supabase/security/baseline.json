  "tableGrants": {
    "digest_send_logs": {
      "anon": [],
      "authenticated": [
        "SELECT"
      ]
    },
    "email_notification_log": {
      "anon": [],
      "authenticated": [
        "SELECT"
      ]
    },
    "affiliate_clicks": {
      "anon": [],
      "authenticated": [
        "SELECT"
      ]
    }
  },
  "auditTriggers": [
    {
      "table": "digest_send_logs",
      "trigger": "audit_digest_send_logs_write"
    },
    {
      "table": "email_notification_log",
      "trigger": "audit_email_notification_log_write"
    },
    {
      "table": "affiliate_clicks",
      "trigger": "audit_affiliate_clicks_write"
    },
    {
      "table": "analytics_events",
      "trigger": "audit_analytics_events_write"
    },
    {
      "table": "user_preferences",
      "trigger": "audit_user_preferences_write"
    },
    {
      "table": "affiliate_clicks",
      "trigger": "affiliate_clicks_enforce_ownership"
    }
  ],
  "functionExecute": {
    "$comment": "SECURITY DEFINER functions in `public`. PUBLIC and anon execute must never be granted \u2014 anonymous surfaces go through service_role edge functions. authenticated execute is only allowed for the functions listed here.",
    "anonAllowlist": [],
    "authenticatedAllowlist": [
      "accept_legal_document",
      "admin_audit_actors",
      "admin_create_payout",
      "admin_legal_document_stats",
      "admin_mark_payout_paid",
      "admin_publish_legal_document",
      "admin_review_verification",
      "admin_set_commission_status",
      "admin_verification_requests",
      "admin_verification_timeline",
      "affiliate_click_is_valid",
      "approve_affiliate_application",
      "attribute_signup_referral",
      "has_role",
      "is_admin",
      "is_anonymous_session",
      "log_admin_access",
      "log_admin_access_denied",
      "log_user_preferences_read",
      "lookup_affiliate_by_code",
      "my_eligibility_state",
      "my_verification_timeline",
      "pending_legal_acceptances",
      "record_checkout_attempt",
      "reject_affiliate_application",
      "request_institution",
      "submit_verification_appeal",
      "submit_verification_request"
    ]
  },
  "findingGuards": [
    {
      "internalId": "SUPA_auth_allow_anonymous_sign_ins",
      "description": "Anonymous (guest) sessions must not be able to read or write user_preferences.",
      "table": "user_preferences",
      "policyRoles": [
        "authenticated"
      ],
      "requiredCmds": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "DELETE"
      ],
      "predicateMustContain": [
        "is_anonymous",
        "auth.uid()"
      ]
    },
    {
      "internalId": "SUPA_auth_allow_anonymous_sign_ins",
      "description": "Anonymous (guest) sessions must not be able to read or write user_integrations.",
      "table": "user_integrations",
      "policyRoles": [
        "authenticated"
      ],
      "requiredCmds": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "DELETE"
      ],
      "predicateMustContain": [
        "is_anonymous",
        "auth.uid()"
      ]
    },
    {
      "internalId": "SUPA_anon_security_definer_function_executable",
      "description": "Only allowlisted SECURITY DEFINER functions may be executable by anon; never by PUBLIC.",
      "functionExecuteRole": "anon"
    },
    {
      "internalId": "SUPA_authenticated_security_definer_function_executable",
      "description": "Only allowlisted SECURITY DEFINER functions may be executable by authenticated.",
      "functionExecuteRole": "authenticated"
    },
    {
      "internalId": "affiliate_clicks_no_insert_policy",
      "description": "Affiliate clicks are written only by the affiliate-track-click edge function (service_role). Clients must hold no INSERT grant, the INSERT policy must deny outright, and the ownership trigger must verify code/profile pairing.",
      "table": "affiliate_clicks",
      "policyRoles": [
        "authenticated"
      ],
      "requiredCmds": [
        "INSERT"
      ],
      "predicateMustContain": [
        "false"
      ]
    }
  ]
}
