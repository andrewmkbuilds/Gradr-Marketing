      "roles": [
        "authenticated"
      ]
    },
    {
      "table": "subscribers",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ]
    },
    {
      "table": "usage_credits",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ]
    },
    {
      "table": "feature_usage",
      "cmd": "SELECT",
