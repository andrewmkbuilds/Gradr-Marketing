        "authenticated"
      ]
    },
    {
      "table": "paddle_subscriptions",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ]
    },
    {
      "table": "digest_send_logs",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ]
    },
    {
      "table": "email_notification_log",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ]
    },
    {
      "table": "interview_sessions",
      "cmd": "ALL",
      "roles": [
        "authenticated"
